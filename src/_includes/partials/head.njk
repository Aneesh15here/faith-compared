<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
{%- set prefix = '' if loc.base == '/' else loc.base -%}
{%- if pageFile == 'index.html' -%}
{%- set pagePath = prefix + '/' -%}
{%- else -%}
{%- set pagePath = prefix + '/' + pageFile -%}
{%- endif -%}
{%- set canonical = site.url + pagePath -%}
{%- set ogImage = site.url + site.ogImage -%}
<link rel="canonical" href="{{ canonical }}" />
{%- for alt in locales -%}
{%- set altPrefix = '' if alt.base == '/' else alt.base -%}
{%- if pageFile == 'index.html' -%}
{%- set altPath = altPrefix + '/' -%}
{%- else -%}
{%- set altPath = altPrefix + '/' + pageFile -%}
{%- endif -%}
<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ site.url + altPath }}" />
{%- endfor -%}
<link rel="alternate" hreflang="x-default" href="{{ site.url + ('/' if pageFile == 'index.html' else '/' + pageFile) }}" />
<meta property="og:type" content="{{ 'article' if seoKind == 'article' else 'website' }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:url" content="{{ canonical }}" />
<meta property="og:image" content="{{ ogImage }}" />
<meta property="og:image:secure_url" content="{{ ogImage }}" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="{{ site.ogImageWidth }}" />
<meta property="og:image:height" content="{{ site.ogImageHeight }}" />
<meta property="og:image:alt" content="{{ site.ogImageAlt }}" />
<meta property="og:locale" content="{{ loc.ogLocale }}" />
{%- for alt in locales -%}
{%- if alt.code != loc.code -%}
<meta property="og:locale:alternate" content="{{ alt.ogLocale }}" />
{%- endif -%}
{%- endfor -%}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description }}" />
<meta name="twitter:image" content="{{ ogImage }}" />
<meta name="twitter:image:alt" content="{{ site.ogImageAlt }}" />
<script type="application/ld+json">{{ structuredData({
  kind: seoKind,
  title: title,
  description: description,
  canonical: canonical,
  lang: loc.hreflang,
  siteName: site.name,
  siteUrl: site.url,
  image: ogImage,
  faqs: faqs[locale]
}) | safe }}</script>
{%- if routeSeo -%}
<script type="application/json" id="route-seo">{{ routeSeo | jsonld | safe }}</script>
<script>
(function () {
  var node = document.getElementById('route-seo');
  if (!node) return;
  var routes = JSON.parse(node.textContent);
  var desc = document.querySelector('meta[name="description"]');
  var ogTitle = document.querySelector('meta[property="og:title"]');
  var ogDesc = document.querySelector('meta[property="og:description"]');
  var twTitle = document.querySelector('meta[name="twitter:title"]');
  var twDesc = document.querySelector('meta[name="twitter:description"]');
  var baseTitle = document.title;
  var baseDesc = desc ? desc.getAttribute('content') : '';
  function apply() {
    var hash = (location.hash || '').replace(/^#\/?/, '').split(/[?/]/)[0];
    var meta = routes[hash];
    var nextTitle = meta && meta.title ? meta.title : baseTitle;
    var nextDesc = meta && meta.description ? meta.description : baseDesc;
    document.title = nextTitle;
    if (desc) desc.setAttribute('content', nextDesc);
    if (ogTitle) ogTitle.setAttribute('content', nextTitle);
    if (ogDesc) ogDesc.setAttribute('content', nextDesc);
    if (twTitle) twTitle.setAttribute('content', nextTitle);
    if (twDesc) twDesc.setAttribute('content', nextDesc);
  }
  apply();
  window.addEventListener('hashchange', apply);
})();
</script>
{%- endif -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css?v={{ site.cacheVersion }}">
{%- if extraCss -%}<link rel="stylesheet" href="{{ extraCss }}?v={{ site.cacheVersion }}">{%- endif -%}
<link rel="icon" href="/icons/icon-192.png" type="image/png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="apple-touch-icon" href="/icons/icon-180.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ chrome.brandTitle }}">
